{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Minimal object PUT/GET without authentication, authorization, quota or S3 compatibility. Do not expose publicly.",
        "title": "OpenS3 Gateway (development API)",
        "contact": {},
        "version": "0.1.0"
    },
    "basePath": "/",
    "paths": {
        "/objects/{bucket}/{key}": {
            "get": {
                "description": "Development-only API. Streams object bytes from the Storage of the version's class. Supports one byte range; a Range header with several ranges or invalid syntax is ignored. Version selection is not supported. The whole request is bounded by GATEWAY_MAX_READ_DURATION.",
                "produces": [
                    "application/octet-stream"
                ],
                "tags": [
                    "objects"
                ],
                "summary": "Read the current object version",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Bucket name",
                        "name": "bucket",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Object key (may contain slashes)",
                        "name": "key",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "One byte range: bytes=first-last, bytes=first- or bytes=-suffix",
                        "name": "Range",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "Strong ETag; the range applies only to the version with this ETag, otherwise the whole object is returned",
                        "name": "If-Range",
                        "in": "header"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "206": {
                        "description": "Partial Content",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "416": {
                        "description": "Requested Range Not Satisfiable",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "504": {
                        "description": "Gateway Timeout",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "put": {
                "description": "Development-only API. No authentication, authorization or quota enforcement. A failed response after Storage may have an unknown Metadata outcome; do not retry blindly.",
                "consumes": [
                    "application/octet-stream"
                ],
                "tags": [
                    "objects"
                ],
                "summary": "Store an object in an existing bucket",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Bucket name",
                        "name": "bucket",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Object key (may contain slashes)",
                        "name": "key",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Raw object bytes",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "type": "string",
                        "description": "MIME type",
                        "name": "Content-Type",
                        "in": "header"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "504": {
                        "description": "Gateway Timeout",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "507": {
                        "description": "Insufficient Storage",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "delete": {
                "description": "Development-only API. Removes the object from Metadata, so later GET returns 404. Blobs stay in Storage: cleanup is not implemented yet.",
                "tags": [
                    "objects"
                ],
                "summary": "Delete an object from the catalog",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Bucket name",
                        "name": "bucket",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Object key (may contain slashes)",
                        "name": "key",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "504": {
                        "description": "Gateway Timeout",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "head": {
                "description": "Development-only API. Calls Metadata only, without reading Storage or publishing object-read. Returns the headers of a full GET without a body. Range and If-Range are ignored. Bounded by METADATA_RPC_TIMEOUT, not GATEWAY_MAX_READ_DURATION.",
                "tags": [
                    "objects"
                ],
                "summary": "Read metadata of the current object version",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Bucket name",
                        "name": "bucket",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Object key (may contain slashes)",
                        "name": "key",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "headers": {
                            "Accept-Ranges": {
                                "type": "string",
                                "description": "bytes"
                            },
                            "Content-Length": {
                                "type": "integer",
                                "description": "Full object size in bytes"
                            },
                            "Content-Type": {
                                "type": "string",
                                "description": "Object content type; application/octet-stream when empty"
                            },
                            "ETag": {
                                "type": "string",
                                "description": "Quoted object ETag"
                            },
                            "X-Content-Type-Options": {
                                "type": "string",
                                "description": "nosniff"
                            },
                            "X-Object-Version-Id": {
                                "type": "string",
                                "description": "Current version ID"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found"
                    },
                    "502": {
                        "description": "Bad Gateway"
                    },
                    "503": {
                        "description": "Service Unavailable"
                    },
                    "504": {
                        "description": "Gateway Timeout"
                    }
                }
            }
        }
    }
}