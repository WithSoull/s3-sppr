# Local run from services/sppr. Compose supplies its own container addresses.
HTTP_ADDRESS=0.0.0.0:8086
SHUTDOWN_TIMEOUT=15s
PG_DSN=postgres://sppr_user:sppr_password@localhost:5436/sppr_db?sslmode=disable
PG_TIMEOUT=5s
PG_LOGGING=false
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_OBJECT_READ_TOPIC=object-read
KAFKA_OBJECT_WRITTEN_TOPIC=object-written
KAFKA_CONSUMER_GROUP_ID=sppr
KAFKA_RETRY_INTERVAL=1s
LOGGER_LEVEL=info
LOGGER_AS_JSON=true
LOGGER_ENABLE_OLTP=false
OTEL_SERVICE_NAME=sppr
OTEL_SERVICE_VERSION=0.1.0
OTEL_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_METRICS_PUSH_TIMEOUT=10s
# Migration executor; the API answers with MIGRATION_ENABLED=false too.
MIGRATION_ENABLED=false
MIGRATION_WORKERS=2
MIGRATION_CLEANUP_INTERVAL=30s
MIGRATION_MAX_ATTEMPTS=5
MIGRATION_RETRY_BACKOFF=1s
MIGRATION_SOURCE_CLEANUP_DELAY=10m
GATEWAY_MAX_READ_DURATION=5m
MIGRATION_BUDGET_BYTES=1GiB
MIGRATION_BUDGET_WINDOW=1h
MIGRATION_MIN_INTERVAL=1h
METADATA_GRPC_ADDR=localhost:50052
METADATA_RPC_TIMEOUT=5s
STORAGE_HOT_GRPC_ADDR=localhost:50056
STORAGE_COLD_GRPC_ADDR=localhost:50053

# Planner and administrator access (defaults are for a local test stand only).
PLANNER_ENABLED=false
PLANNER_INTERVAL=300s
PLANNER_HORIZON=1h
# Legacy predictor selector; stage 9 uses the journal and automatic EWMA fallback.
PLANNER_PREDICTOR=ewma
# Optional bootstrap import, only when the journal is empty.
PLANNER_MODEL_DIR=
# Leave unset to inherit PLANNER_ENABLED. Explicit false opens the API locally.
# ADMIN_AUTH_ENABLED=false
AUTH_GRPC_ADDR=localhost:50050
AUTHZ_GRPC_ADDR=localhost:50051
AUTH_RPC_TIMEOUT=5s
AUTHZ_RPC_TIMEOUT=5s
USERS_GRPC_ADDR=localhost:50054
PLANNER_ADMIN_EMAIL=planner-admin@example.test
PLANNER_ADMIN_PASSWORD=PlannerAdmin123!

# Direct host run: use a writable local path. Compose uses its named volume.
PLANNER_MODEL_REGISTRY=./build/model-registry
PLANNER_MODEL_MAX_AGE=72h
PLANNER_MODEL_UPDATE_EVERY=24h
PLANNER_MODEL_MIN_HISTORY=26h
PLANNER_MODEL_TRAIN_WINDOW=168h
PLANNER_MODEL_TRAIN_TIMEOUT=30m
PLANNER_TRAIN_COMMAND=python -m sppr_ml train --data {data} --out {out} --params {params}
# Stage 5 history completeness
INGEST_STREAM_LOST_AFTER=30s
PLANNER_MAX_HISTORY_LAG=60s
